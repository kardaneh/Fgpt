#!/usr/bin/env bash

DATE=$(date +"%Y%m%d")
TODAY=$(date +"%Y%m%d_%H%M%S")

# Choose which fgpt subcommand this setup should drive.
#   "isolator" -> fgpt isolate  ... (Stages 1 - 3)
#   "autodiff" -> fgpt autodiff ... (Stage 3)
COMMAND="isolator"

# How to invoke the CLI. If fgpt is installed (pip install -e .) and
# exposes a console entry point, "fgpt" works directly. Otherwise use:
#   FGPT_CMD="python -m fgpt.cli"
FGPT_CMD="fgpt"

# Path configuration
WORK_DIR="$work"  # Using environment variable
REST_OF_PATH="modipsl_truck_opt/modeles/ORCHIDEE/src_sechiba/"
#TARGET_MODULE="albedo_surface" #"condveg"
TARGET_MODULE="hydrol"

# Parent and target subroutines
#PARENT_SUBROUTINE="albedo_surface_main" #"condveg_main"
#TARGET_SUBROUTINES="multilevel_matrix" #"albedo_surface_main"
PARENT_SUBROUTINE="hydrol_main"
TARGET_SUBROUTINES="hydrol_alma hydrol_vegupd hydrol_canop hydrol_flood hydrol_hydraulic_arch_tuzet_calc hydrol_soil explicitsnow_main"

# Isolation options
OPENACC="False"
F2PY="True"
TAPENADE="False"
PY2JX="False"

# Autodiff configuration
CONFIG_PATH="template.yaml"
CLASS_FILE="hydrol/hydrol_vegupd/global_module_hydrol_vegupd.py"
MAIN_FILE="hydrol/hydrol_vegupd/main_hydrol_vegupd.py"
MODE="jax"
BENCHMARK_DIR="benchmark"
VECTORIZE="kjpindex"

# Script Generation
run_script="run_${COMMAND}.sh"


if [[ "$COMMAND" == "isolator" ]]; then
cat > "$run_script" <<EOF
#!/usr/bin/env bash
echo "Starting isolation: $TODAY"
echo "Target module: $TARGET_MODULE"
echo "Parent subroutine: $PARENT_SUBROUTINE"
echo "Target subroutines: $TARGET_SUBROUTINES"
echo "OpenACC: $OPENACC, F2PY: $F2PY, Tapenade: $TAPENADE", PY2JX: $PY2JX
echo "=========================================="
$FGPT_CMD isolate \\
    --work "$WORK_DIR" \\
    --rest_of_path "$REST_OF_PATH" \\
    --target_module "$TARGET_MODULE" \\
    --parent_subroutine "$PARENT_SUBROUTINE" \\
    --target_subroutines $TARGET_SUBROUTINES \\
    --openacc "$OPENACC" \\
    --f2py "$F2PY" \\
    --tapenade "$TAPENADE" \\
    --py2jx "$PY2JX" \\
    --config_path "$CONFIG_PATH" \\
    --vectorize $VECTORIZE \\
    --mode "$MODE" \\
    --benchmark_dir "$BENCHMARK_DIR" \\

echo "=========================================="
echo "Isolation completed: \$(date)"
EOF

elif [[ "$COMMAND" == "autodiff" ]]; then
BENCHMARK_ARG=""
if [[ -n "$BENCHMARK_DIR" ]]; then
    BENCHMARK_ARG="--benchmark_dir \"$BENCHMARK_DIR\""
fi

cat > "$run_script" <<EOF
#!/usr/bin/env bash
echo "Starting autodiff transform: $TODAY"
echo "Config: $CONFIG_PATH"
echo "Class file: $CLASS_FILE"
echo "Main file: $MAIN_FILE"
echo "Mode: $MODE"
echo "Vectorize: $VECTORIZE"
echo "=========================================="
$FGPT_CMD autodiff \\
    --config_path "$CONFIG_PATH" \\
    --class_file "$CLASS_FILE" \\
    --main_file "$MAIN_FILE" \\
    --mode "$MODE" \\
    --vectorize $VECTORIZE \\
    $BENCHMARK_ARG
echo "=========================================="
echo "Autodiff completed: \$(date)"
EOF

else
    echo "Unknown COMMAND: $COMMAND (expected 'isolator' or 'autodiff')" >&2
    exit 1
fi

chmod +x "$run_script"

echo "=== fgpt Setup Complete ($COMMAND) ==="
if [[ "$COMMAND" == "isolator" ]]; then
    echo "Target Module: $TARGET_MODULE"
    echo "Source Path: $REST_OF_PATH"
    echo "Work Directory: $WORK_DIR"
    echo "Parent Subroutine: $PARENT_SUBROUTINE"
    echo "Target Subroutines: $TARGET_SUBROUTINES"
    echo "Features - OpenACC: $OPENACC, F2PY: $F2PY, Tapenade: $TAPENADE, PY2JX: $PY2JX"
else
    echo "Config Path: $CONFIG_PATH"
    echo "Class File: $CLASS_FILE"
    echo "Main File: $MAIN_FILE"
    echo "Mode: $MODE"
    echo "Vectorize: $VECTORIZE"
    [[ -n "$BENCHMARK_DIR" ]] && echo "Benchmark Dir: $BENCHMARK_DIR"
fi
echo ""
echo "Run script generated: ./$run_script"
echo ""
echo "To execute:"
echo "  ./$run_script"
